# Copy to .env and fill in your own values.

PORT=5000

# Paste your MongoDB connection string here.
# Local:  mongodb://127.0.0.1:27017/gyankendra
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gyankendra?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string. Tokens signed with it are invalidated if you change it.
JWT_SECRET_KEY=

JWT_EXPIRES_IN=7d
# Atlas SRV lookups fail on some networks ("querySrv ECONNREFUSED").
# The server uses public DNS resolvers by default; set to "system" to opt out.
DNS_SERVERS=8.8.8.8,8.8.4.4

# Starting offset for the public landing-page counters, so a fresh install
# does not show a row of zeros. Real activity is added on top of these.
# Set them all to 0 to publish only genuine counts.
STATS_BASELINE_USERS=100
STATS_BASELINE_TOPICS=850
STATS_BASELINE_RESOURCES=2400
STATS_BASELINE_COMPLETED=320

# Rate limits. Generating a transcript reaches out to YouTube, so it is
# capped per user; the auth limit is keyed by IP to slow password guessing.
TRANSCRIPT_PER_MINUTE=6
TRANSCRIPT_PER_HOUR=60
AUTH_ATTEMPTS_PER_15MIN=20

# Structured notes are generated with Google Gemini Flash.
# Get a key at https://aistudio.google.com/apikey — the feature stays hidden
# until this is set, the rest of the app works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Tried in order if the primary is retired or overloaded.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_ATTEMPT_TIMEOUT_MS=75000
NOTES_PER_MINUTE=3
NOTES_PER_HOUR=20
# Server-wide ceiling: the cap that actually bounds your Gemini bill.
NOTES_GLOBAL_PER_HOUR=120

NODE_ENV=development
CLIENT_URL=http://localhost:5173
